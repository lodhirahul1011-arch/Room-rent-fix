PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/roomrent?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-secure-32-character-secret-key-1234
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKER_ENABLED=false
RESEND_API_KEY=
RESEND_TEMPLATE_ID=
RESEND_FROM_EMAIL=
CONTACT_EMAIL=

# Durable private meter-photo storage (required; never use a public bucket).
PRIVATE_STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=AES256
METER_PHOTO_MAX_BYTES=5242880
